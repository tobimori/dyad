{
  "name": "@dyad/cli",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack && node --experimental-ffi --env-file-if-exists=.env.local dist/main.mjs",
    "start": "node --experimental-ffi dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "build:linux-x64": "DYAD_EXE_TARGET=linux-x64 vp pack",
    "build:linux-arm64": "DYAD_EXE_TARGET=linux-arm64 vp pack",
    "build:darwin-arm64": "DYAD_EXE_TARGET=darwin-arm64 vp pack"
  },
  "dependencies": {
    "@dyad/client-runtime": "workspace:*",
    "@dyad/domain": "workspace:*",
    "@dyad/plugin": "workspace:*",
    "@dyad/plugin-discord-presence": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@effect/platform-node": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/react": "catalog:",
    "effect": "catalog:",
    "env-paths": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}
