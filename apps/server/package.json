{
  "name": "@dyad/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:tailscale": "portless --tailscale",
    "dev:app": "node --conditions=development --env-file=.env.development --env-file-if-exists=.env.local --watch src/main.ts",
    "start": "node dist/main.mjs",
    "join": "node --conditions=development src/join.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dyad/db": "workspace:*",
    "@dyad/domain": "workspace:*",
    "@dyad/host": "workspace:*",
    "@dyad/server-core": "workspace:*",
    "@dyad/web": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "portless": {
    "name": "api.dyad",
    "script": "dev:app"
  }
}
