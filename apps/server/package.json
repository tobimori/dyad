{
  "name": "@dyad/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:tailscale": "portless --tailscale",
    "dev:app": "node --conditions=development --env-file=.env.development --env-file-if-exists=.env.local --watch src/main.ts",
    "start": "node dist/main.mjs",
    "join": "node --conditions=development src/join.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dyad/db": "workspace:*",
    "@dyad/domain": "workspace:*",
    "@dyad/plugin": "workspace:*",
    "@dyad/plugin-airplay": "workspace:*",
    "@dyad/plugin-apple-music": "workspace:*",
    "@dyad/plugin-bandcamp": "workspace:*",
    "@dyad/plugin-cast": "workspace:*",
    "@dyad/plugin-deezer": "workspace:*",
    "@dyad/plugin-hypem": "workspace:*",
    "@dyad/plugin-local-files": "workspace:*",
    "@dyad/plugin-mixesdb": "workspace:*",
    "@dyad/plugin-musicbrainz": "workspace:*",
    "@dyad/plugin-soundcloud": "workspace:*",
    "@dyad/plugin-youtube": "workspace:*",
    "@dyad/server-core": "workspace:*",
    "@dyad/web": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "env-paths": "catalog:"
  },
  "portless": {
    "name": "api.dyad",
    "script": "dev:app"
  }
}
