{
  "name": "dyad",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @dyad/server --filter @dyad/web --parallel dev",
    "dev:tailscale": "vp run --filter @dyad/server --filter @dyad/web --parallel dev:tailscale",
    "dev:app": "vp run --filter @dyad/server --filter @dyad/web --parallel dev:app",
    "dev:server": "vp run @dyad/server#dev",
    "dev:web": "vp run @dyad/web#dev",
    "build": "vp run -r build",
    "check": "vp fmt --check && vp lint apps packages && vp exec tsc --noEmit && vp run -r typecheck",
    "format": "vp fmt",
    "db:generate": "vp run @dyad/db#generate",
    "start": "vp run @dyad/server#start",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@11.3.0"
}
