{
  "name": "@dyad/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "development": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate --name",
    "generate-client": "node scripts/generate-client-migration.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
